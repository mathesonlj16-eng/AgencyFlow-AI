# AgencyFlow AI reads these from the process environment (.env is NOT loaded automatically).

# Local model via Ollama (default)
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen3.5:4b
# Seconds to wait for one model response (small local models are slow)
MODEL_TIMEOUT=300

# Optional OpenAI-compatible provider instead (paid; never commit credentials):
# AI_PROVIDER=openai
# OPENAI_API_KEY=replace-with-your-secret
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: only human-approved plans are ever sent to this webhook
# N8N_WEBHOOK_URL=http://localhost:5679/webhook/agencyflow-reviewed
# HANDOFF_TIMEOUT=15

# Set before exposing the backend beyond localhost. Visitors enter it in the UI.
# DEMO_ACCESS_CODE=choose-a-long-random-code
# DB_PATH=./data/agencyflow.sqlite3

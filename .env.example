# Local development (works with Ollama already running on your machine)
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen3.5:2b

# For hosted use instead (never commit credentials):
# AI_PROVIDER=openai
# OPENAI_API_KEY=replace-with-your-secret
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: only approved plans may be sent to this webhook
# N8N_WEBHOOK_URL=https://your-n8n-host/webhook/agencyflow-reviewed

# Set before exposing a public backend. Visitors will enter it in the UI.
# DEMO_ACCESS_CODE=choose-a-long-random-code
# DB_PATH=./data/agencyflow.sqlite3

    {
      "parameters": {
        "jsCode": "// One item per approved task. external_ref is stable, so storing it twice is impossible (upsert below).\nconst e = $('New approved plan?').first().json.event;\nconst at = new Date().toISOString();\nreturn e.plan.tasks.map((t, i) => ({ json: {\n  external_ref: `${e.event_id}#${i + 1}`, event_id: e.event_id, campaign: e.plan.campaign_name,\n  title: t.title, assignee_role: t.role, priority: t.priority, due_date: t.due_date ?? '',\n  status: 'To do', description: t.detail ?? '', received_at: at,\n} }));"
      },
      "id": "706afe03-8df1-5819-9fb4-d43e100f8215",
      "name": "Prepare tracker cards",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        200
      ]
    },

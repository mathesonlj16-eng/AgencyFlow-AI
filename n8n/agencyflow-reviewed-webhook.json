{
  "id": "AgFlowReceiverV2",
  "name": "AgencyFlow AI - Approved Plan Receiver (stores tasks locally, external writes disabled)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "agencyflow-reviewed",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "5e4ab1d1-47bd-42d3-9d29-3284a1b5f90d",
      "name": "Receive approved plan",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "d8f42360-f1c5-46e9-9f93-084a37d5329b"
    },
    {
      "parameters": {
        "jsCode": "// Validate the human-approved payload and block replays by event_id.\n// Seen event ids live in workflow static data, which n8n persists for production (active) executions.\nconst body = $input.first().json.body ?? {};\nconst errors = [];\nif (body.schema_version !== 'agencyflow.v1') errors.push('unsupported schema_version');\nif (typeof body.event_id !== 'string' || !/^af-\\d+-[0-9a-f]{12}$/.test(body.event_id)) errors.push('missing or malformed event_id');\nif (!body.reviewed_at) errors.push('plan was not human-approved (reviewed_at missing)');\nconst tasks = body.plan?.tasks;\nif (!Array.isArray(tasks) || tasks.length === 0) errors.push('plan has no tasks');\nif (errors.length) {\n  return [{ json: { outcome: 'rejected', http: 422, response: { status: 'rejected', error: errors.join('; ') } } }];\n}\n\n// Cheap content fingerprint (djb2) so a reused event_id with different content is caught.\nconst text = JSON.stringify(body.plan);\nlet h = 5381;\nfor (let i = 0; i < text.length; i++) h = ((h << 5) + h + text.charCodeAt(i)) >>> 0;\nconst fingerprint = h.toString(16);\n\nconst store = $getWorkflowStaticData('global');\nstore.seen = store.seen ?? {};\nconst prev = store.seen[body.event_id];\nif (prev && prev.fingerprint === fingerprint) {\n  return [{ json: { outcome: 'duplicate', http: 200, response: { status: 'duplicate_ignored', duplicate: true, event_id: body.event_id, first_received_at: prev.at, external_actions: 'none' } } }];\n}\nif (prev) {\n  return [{ json: { outcome: 'conflict', http: 409, response: { status: 'conflict', error: 'event_id already used for a different plan', event_id: body.event_id } } }];\n}\nstore.seen[body.event_id] = { fingerprint, at: new Date().toISOString(), tasks: tasks.length };\nconst ids = Object.keys(store.seen);\nif (ids.length > 500) for (const id of ids.slice(0, ids.length - 500)) delete store.seen[id];\n\nreturn [{ json: { outcome: 'accepted', http: 200, event: body } }];"
      },
      "id": "11e8b829-70b2-4fa9-bfc6-06ad1f82a9c7",
      "name": "Validate + replay check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
